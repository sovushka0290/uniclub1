rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['telegramId', 'firstName', 'enrolledCourses', 'createdAt', 'updatedAt'])
               && data.keys().size() == 5
               && data.telegramId is string && data.telegramId.size() <= 64
               && data.firstName is string && data.firstName.size() <= 100
               && data.enrolledCourses is list && data.enrolledCourses.size() <= 50
               && data.createdAt == request.time
               && data.updatedAt == request.time;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId)
                    && incoming().telegramId == existing().telegramId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      // Only allow updating firstName or lastName
                      incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'updatedAt'])
                    );
      allow list: if false; // Users cannot list other users
    }

    // Course Rules
    match /courses/{courseId} {
      allow get: if true; // Publicly viewable
      allow list: if true; // Publicly listable
      // Writes only via admin (not implemented in this iteration's client)
      allow write: if false;
    }
  }
}
